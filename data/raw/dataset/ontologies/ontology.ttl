@prefix : <https://w3id.org/pmd/materials-mechanics-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/pmd/materials-mechanics-ontology#> .

<https://w3id.org/pmd/materials-mechanics-ontology> rdf:type owl:Ontology ;
                                                     owl:versionIRI <https://w3id.org/pmd/materials-mechanics-ontology/1.0.1> ;
                                                     owl:imports <https://w3id.org/pmd/co/2.0.4> ;
                                                     <http://purl.org/dc/elements/1.1/creator> "https://orcid.org/0000-0002-0916-5990"^^xsd:anyURI ,
                                                                                               "https://orcid.org/0000-0003-0744-8855"^^xsd:anyURI ;
                                                     <http://purl.org/dc/elements/1.1/title> "Materials Mechanics Ontology"@en ;
                                                     <http://purl.org/dc/terms/created> "2024-01-30" ;
                                                     <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
                                                     rdfs:comment "The materials mechanics ontology is an application-level ontology that was created for supporting named entity recognition tasks for materials fatigue domain. The ontology covers some fairly general MSE concepts that could prospectively be merged into PMDco or other upper materials ontologies such as descriptions of crystallographic defects and microstructural entities. Furthermore, concepts related to the materials fatigue subdomain are also heavily incorporated."@en ;
                                                     owl:versionInfo "1.0.1"@en .

#################################################################
#    Annotation properties
#################################################################

###  https://w3id.org/pmd/materials-mechanics-ontology/altLabel
<https://w3id.org/pmd/materials-mechanics-ontology/altLabel> rdf:type owl:AnnotationProperty .


###  https://w3id.org/pmd/materials-mechanics-ontology/prefLabel
<https://w3id.org/pmd/materials-mechanics-ontology/prefLabel> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/isPartOf
<http://purl.org/dc/terms/isPartOf> rdfs:label "Is Part Of"@en ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "A related resource in which the described resource is physically or logically included."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/alignedWith
<https://w3id.org/pmd/materials-mechanics-ontology/alignedWith> rdf:type owl:ObjectProperty ;
                                                                rdfs:subPropertyOf owl:topObjectProperty ;
                                                                rdf:type owl:SymmetricProperty ;
                                                                rdfs:domain <http://www.w3.org/ns/prov#Entity> ;
                                                                rdfs:range <http://www.w3.org/ns/prov#Entity> ;
                                                                rdfs:label "aligned with"@en ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "The object property alignedWith describes that the entity representing the subject is aligned to another entity representing an object."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/associatedWith
<https://w3id.org/pmd/materials-mechanics-ontology/associatedWith> rdf:type owl:ObjectProperty ,
                                                                            owl:SymmetricProperty ;
                                                                   rdfs:label "associated with"@en ;
                                                                   <http://www.w3.org/2004/02/skos/core#definition> "associatedWith Is a general object property that describes the concept of association between two entities, i.e. that one entity holds information about another entity."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/causeOf
<https://w3id.org/pmd/materials-mechanics-ontology/causeOf> rdf:type owl:ObjectProperty ;
                                                            rdfs:subPropertyOf <http://www.w3.org/ns/prov#influenced> ,
                                                                               <https://w3id.org/pmd/materials-mechanics-ontology/associatedWith> ;
                                                            rdf:type owl:IrreflexiveProperty ;
                                                            rdfs:label "cause of"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> """causeOf Is a general object property which describes the concept of causation, i.e. cause-effect relationships. The subject acts as a (direct or indirect) cause for an effect which is represented by the object. 
This relationship is applied if the subject, i.e. activity, entity, state, is (partly) responsible for another activity, entity, state.

Note: An example for an indirect causal relationship is between grain size and flow stress (strength). Before a threshold in grain size the behaviour is dominated by grain boundary sliding (resulting in an increasing trend) while above the strength is dominated by grain boundary resistance to dislocation slip (resulting in a decreasing trend). The lack of a clear increasing or decreasing trend means that grain size and strength are not correlated, even though a causal relationship exists."""@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/constrains
<https://w3id.org/pmd/materials-mechanics-ontology/constrains> rdf:type owl:ObjectProperty ;
                                                               rdfs:subPropertyOf <http://www.w3.org/ns/prov#influenced> ;
                                                               rdfs:label "constrains"@en ;
                                                               <http://www.w3.org/2004/02/skos/core#definition> "The constrains object property is used to signify that the subject imposes some bounds on the object."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/correlatedWith
<https://w3id.org/pmd/materials-mechanics-ontology/correlatedWith> rdf:type owl:ObjectProperty ;
                                                                   rdfs:subPropertyOf <https://w3id.org/pmd/materials-mechanics-ontology/associatedWith> ;
                                                                   rdf:type owl:SymmetricProperty ;
                                                                   rdfs:label "correlated with"@en ;
                                                                   <http://www.w3.org/2004/02/skos/core#definition> "correlatedWith Is a general object property which indicates linear (Pearson) or non-linear (Spearman) correlation between two entities."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/growsInto
<https://w3id.org/pmd/materials-mechanics-ontology/growsInto> rdf:type owl:ObjectProperty ;
                                                              rdfs:subPropertyOf owl:topObjectProperty ,
                                                                                 <http://www.w3.org/ns/prov#hadDerivation> ;
                                                              rdf:type owl:TransitiveProperty ;
                                                              rdfs:label "grows into"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "growsInto object property describes the spatial growth of an entity into an entity of another type. A materials science specific example would be the growth of a microstructurally-short crack into a physically-short crack."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/hardConstrains
<https://w3id.org/pmd/materials-mechanics-ontology/hardConstrains> rdf:type owl:ObjectProperty ;
                                                                   rdfs:subPropertyOf <https://w3id.org/pmd/materials-mechanics-ontology/constrains> ;
                                                                   rdfs:label "hard constrains"@en ;
                                                                   <http://www.w3.org/2004/02/skos/core#definition> "The hardConstrains object property is used to signify that the subject imposes hard bounds on the object. For instance, a load cell built into a mechanical testing setup asserts hard bounds to the measurable force."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/initiatesAt
<https://w3id.org/pmd/materials-mechanics-ontology/initiatesAt> rdf:type owl:ObjectProperty ;
                                                                rdfs:subPropertyOf owl:topObjectProperty ;
                                                                rdfs:domain <https://w3id.org/pmd/materials-mechanics-ontology/Damage> ;
                                                                rdfs:range <https://w3id.org/pmd/materials-mechanics-ontology/Defect> ;
                                                                rdfs:label "initiates at"@en ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "The object property initiatesAt describes the initiation of an entity at a specific location. A materials science specific example would be the initiation of a crack at a specific grain boundary segment."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/isPartOf
<https://w3id.org/pmd/materials-mechanics-ontology/isPartOf> rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf <http://purl.org/dc/terms/isPartOf> ;
                                                             rdf:type owl:TransitiveProperty ;
                                                             rdfs:label "Is Part Of"@en ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "A related resource in which the described resource is physically or logically included. This object property is transitive."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/measures
<https://w3id.org/pmd/materials-mechanics-ontology/measures> rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf owl:topObjectProperty .


###  https://w3id.org/pmd/materials-mechanics-ontology/necessaryCauseOf
<https://w3id.org/pmd/materials-mechanics-ontology/necessaryCauseOf> rdf:type owl:ObjectProperty ;
                                                                     rdfs:subPropertyOf <https://w3id.org/pmd/materials-mechanics-ontology/causeOf> ;
                                                                     rdfs:label "necessary cause of"@en ;
                                                                     <http://www.w3.org/2004/02/skos/core#definition> "Causation where the presence of the object implies prior occurence of subject (object is only attainable by subject). However, the presence of the subject does not imply that the object will inevitably occur."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/parallelTo
<https://w3id.org/pmd/materials-mechanics-ontology/parallelTo> rdf:type owl:ObjectProperty ;
                                                               rdfs:subPropertyOf <https://w3id.org/pmd/materials-mechanics-ontology/alignedWith> ;
                                                               rdf:type owl:SymmetricProperty ;
                                                               rdfs:label "parallel to"@en ;
                                                               <http://www.w3.org/2004/02/skos/core#definition> "The object property parallelTo describes that the entity representing the subject is parallely aligned to another entity representing an object."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/precedes
<https://w3id.org/pmd/materials-mechanics-ontology/precedes> rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf owl:topObjectProperty .


###  https://w3id.org/pmd/materials-mechanics-ontology/reliesOn
<https://w3id.org/pmd/materials-mechanics-ontology/reliesOn> rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf owl:topObjectProperty ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "Describes a relation where the object is a necessary condition for the subject to occur."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/softConstrains
<https://w3id.org/pmd/materials-mechanics-ontology/softConstrains> rdf:type owl:ObjectProperty ;
                                                                   rdfs:subPropertyOf <https://w3id.org/pmd/materials-mechanics-ontology/constrains> ;
                                                                   rdfs:label "soft constrains"@en ;
                                                                   <http://www.w3.org/2004/02/skos/core#definition> "The softConstrains object property is used to signify that the subject imposes soft bounds on the object. For instance, in materials engineering, the recycling-induced elevated presence of copper in steel asserts some soft bounds on its processing window to avoid embrittlement and hot shortness."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/spatiallyCoincidesWith
<https://w3id.org/pmd/materials-mechanics-ontology/spatiallyCoincidesWith> rdf:type owl:ObjectProperty ,
                                                                                    owl:SymmetricProperty ;
                                                                           rdfs:domain <http://www.w3.org/ns/prov#Entity> ;
                                                                           rdfs:range <http://www.w3.org/ns/prov#Entity> ;
                                                                           rdfs:label "spatially coincides with"@en ;
                                                                           <http://www.w3.org/2004/02/skos/core#definition> "The object property spatiallyCoincidesWith describes that the entity representing the subject is spatially coinciding with another entity representing an object. An example is that a specific element (or it‘s ion) occupies a position in a crystal lattice."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/sufficientCauseOf
<https://w3id.org/pmd/materials-mechanics-ontology/sufficientCauseOf> rdf:type owl:ObjectProperty ;
                                                                      rdfs:subPropertyOf <https://w3id.org/pmd/materials-mechanics-ontology/causeOf> ;
                                                                      rdfs:label "sufficient cause of"@en ;
                                                                      <http://www.w3.org/2004/02/skos/core#definition> "Causation where the presence of the subject implies the subsequent occurence of the object. No other conditions need to be fulfilled to cause the object. At the same time, presence of the object does not imply prior occurence of the subject since other entities can result in the same effect."@en .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/CHEBI_24431
<http://purl.obolibrary.org/obo/CHEBI_24431> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/Chemical> .


###  https://w3id.org/pmd/co/AnalysingProcess
<https://w3id.org/pmd/co/AnalysingProcess> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/CharacterizationProcess> .


###  https://w3id.org/pmd/co/BaseMaterial
<https://w3id.org/pmd/co/BaseMaterial> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/Material> .


###  https://w3id.org/pmd/co/Dataset
<https://w3id.org/pmd/co/Dataset> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/DataSet> .


###  https://w3id.org/pmd/co/EngineeredMaterial
<https://w3id.org/pmd/co/EngineeredMaterial> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/pmd/co/characteristic> ;
                                                               owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/MaterialProperty>
                                                             ] .


###  https://w3id.org/pmd/co/Extensometer
<https://w3id.org/pmd/co/Extensometer> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/pmd/materials-mechanics-ontology/measures> ;
                                                         owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/Strain>
                                                       ] .


###  https://w3id.org/pmd/co/Identifier
<https://w3id.org/pmd/co/Identifier> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/Identifier> .


###  https://w3id.org/pmd/co/LoadCell
<https://w3id.org/pmd/co/LoadCell> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/pmd/materials-mechanics-ontology/measures> ;
                                                     owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/Force>
                                                   ] .


###  https://w3id.org/pmd/co/Location
<https://w3id.org/pmd/co/Location> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/Location> .


###  https://w3id.org/pmd/co/ManufacturingProcess
<https://w3id.org/pmd/co/ManufacturingProcess> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/ManufacturingProcess> .


###  https://w3id.org/pmd/co/MaterialDesignation
<https://w3id.org/pmd/co/MaterialDesignation> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/MaterialClass> .


###  https://w3id.org/pmd/co/Object
<https://w3id.org/pmd/co/Object> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/Object> .


###  https://w3id.org/pmd/co/Process
<https://w3id.org/pmd/co/Process> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/Process> .


###  https://w3id.org/pmd/co/Sample
<https://w3id.org/pmd/co/Sample> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/Sample> .


###  https://w3id.org/pmd/co/SimulationProcess
<https://w3id.org/pmd/co/SimulationProcess> owl:equivalentClass <https://w3id.org/pmd/materials-mechanics-ontology/SimulationProcess> .


###  https://w3id.org/pmd/co/Thermocouple
<https://w3id.org/pmd/co/Thermocouple> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/pmd/materials-mechanics-ontology/measures> ;
                                                         owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/Temperature>
                                                       ] .


###  https://w3id.org/pmd/materials-mechanics-ontology/AcousticDissipation
<https://w3id.org/pmd/materials-mechanics-ontology/AcousticDissipation> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/MechanicalProperty> ;
                                                                        rdfs:label "Acoustic dissipation"@en ;
                                                                        <http://www.w3.org/2004/02/skos/core#definition> "synonym acoustic attenuation"@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/Ag
<https://w3id.org/pmd/materials-mechanics-ontology/Ag> rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/ChemicalElement> ;
                                                       rdfs:label "Silver"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "Content of element"@en ;
                                                       <https://w3id.org/pmd/co/symbol> "Ag"@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/Aging
<https://w3id.org/pmd/materials-mechanics-ontology/Aging> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/Mechanism> ;
                                                          rdfs:label "Aging"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#altLabel> "Age hardeninig"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "The gradual process of change in the properties of a material owing to structural changes which occur over time under specific conditions." ;
                                                          <https://w3id.org/pmd/co/definitionSource> "GPT-4 generated description with manual adjustments" .


###  https://w3id.org/pmd/materials-mechanics-ontology/Al
<https://w3id.org/pmd/materials-mechanics-ontology/Al> rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/ChemicalElement> ;
                                                       rdfs:label "Aluminum"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "Content of element"@en ;
                                                       <https://w3id.org/pmd/co/symbol> "Al"@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/Alloy
<https://w3id.org/pmd/materials-mechanics-ontology/Alloy> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://w3id.org/pmd/co/BaseMaterial> ,
                                                                          <https://w3id.org/pmd/materials-mechanics-ontology/Material> ;
                                                          rdfs:label "Alloy"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "An alloy is an inorganic material with a defined chemical composition consisting primarily of metals but potentially also other chemical elements."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/AlternatingStrength
<https://w3id.org/pmd/materials-mechanics-ontology/AlternatingStrength> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/MechanicalProperty> ;
                                                                        rdfs:label "Alternating strength"@en ;
                                                                        <http://www.w3.org/2004/02/skos/core#definition> """According to \"FKM-Richtlinie - Rechnerischer Festigkeitsnachweis (2012)\" and \"Höchstfeste Stähle, IGF-Vorhaben Nr. 19667 BG\", the alternating strength is a numerical value that is calculated via the fatigue strength of a material and the mean stress factor. The alternate strength allows the engineer to compare fatigue strengths obtained from tests with different stress ratios (mean stress). It converts the fatigue strength value to an alternate strength value for R=-1.
S_WK = fatigue strength / K_AK. """@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/AngularRotationcontrolled
<https://w3id.org/pmd/materials-mechanics-ontology/AngularRotationcontrolled> rdf:type owl:Class ;
                                                                              rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/ControlType> ;
                                                                              rdfs:label "Angular rotation-controlled"@en ;
                                                                              <http://www.w3.org/2004/02/skos/core#definition> "A control type during mechanical testing where the angular rotation of a bending beam is the controlled variable." ;
                                                                              <https://w3id.org/pmd/co/definitionSource> "GPT-4 generated description with manual adjustments" .


###  https://w3id.org/pmd/materials-mechanics-ontology/Annealing
<https://w3id.org/pmd/materials-mechanics-ontology/Annealing> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/HeatTreatment> ;
                                                              rdfs:label "Annealing"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "Annealing is a heat treatment that alters the physical and sometimes chemical properties of a material to increase ist ductility and reduce ist hardness, making it more workable. It involves heating a material above ist recrystallization temperature, maintaining a suitable temperature for an appropriate amount of time and then cooling."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/As
<https://w3id.org/pmd/materials-mechanics-ontology/As> rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/ChemicalElement> ;
                                                       rdfs:label "Arsen"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "Content of element"@en ;
                                                       <https://w3id.org/pmd/co/symbol> "As"@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/Austenite
<https://w3id.org/pmd/materials-mechanics-ontology/Austenite> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/Phase> ;
                                                              rdfs:label "Austenite"@en ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "The high temperature phase in steels with a face-centered cubic unit cell."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/AusteniteTransformationTemperatureAc1
<https://w3id.org/pmd/materials-mechanics-ontology/AusteniteTransformationTemperatureAc1> rdf:type owl:Class ;
                                                                                          rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/MicrostructuralProperty> ;
                                                                                          rdfs:label "Austenite transformation temperature Ac1"@en ;
                                                                                          <http://www.w3.org/2004/02/skos/core#definition> "The Ac1 austenite transformation temperature depends on the heating rate at marks the temperature at which austenite transformation is initiated."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/AusteniteTransformationTemperatureAc3
<https://w3id.org/pmd/materials-mechanics-ontology/AusteniteTransformationTemperatureAc3> rdf:type owl:Class ;
                                                                                          rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/MicrostructuralProperty> ;
                                                                                          rdfs:label "Austenite transformation temperature Ac3"@en ;
                                                                                          <http://www.w3.org/2004/02/skos/core#definition> "The Ac3 austenite transformation temperature depends on the heating rate at marks the temperature at which austenite transformation is completed."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/Austenitizing
<https://w3id.org/pmd/materials-mechanics-ontology/Austenitizing> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/HeatTreatment> ;
                                                                  rdfs:label "Austenitizing"@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#definition> "Austenitizing means that a steel is heated above the austenitizing temperature (GSE line in the iron carbon diagram). This process changes the lattice structure from a body centered cubic structure (BCC) to a face centered cubic structure (FCC), allowing a martensitic transformation via quenching."@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/B
<https://w3id.org/pmd/materials-mechanics-ontology/B> rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/ChemicalElement> ;
                                                      rdfs:label "Borium"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Content of element"@en ;
                                                      <https://w3id.org/pmd/co/symbol> "B"@en .


###  https://w3id.org/pmd/materials-mechanics-ontology/Bainite
<https://w3id.org/pmd/materials-mechanics-ontology/Bainite> rdf:type owl:Class ;
                                                            rdfs:subClassOf <https://w3id.org/pmd/materials-mechanics-ontology/Microstructure> ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <https://w3id.org/pmd/co/composedOf> ;
                                                                              owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/Carbide>
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <https://w3id.org/pmd/co/composedOf> ;
                                                                              owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/Ferrite>
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <https://w3id.org/pmd/co/composedOf> ;
                                                                              owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/MartensiteAusteniteIsland>
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <https://w3id.org/pmd/co/composedOf> ;
                                                                              owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/Pearlite>
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <https://w3id.org/pmd/co/composedOf> ;
                                                                              owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/RetainedAustenite>
                                                                            ] ;
                                                            rdfs:label "Bainite"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "Bainite is a microstructure formed after quenching at intermediate cooling rates where the ferritic consituents are arranged in a hierarchical manner, additionally carbides, retained austenite, pearlite or martensite-austenite are often present."@en .


