                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/pmd/co/characteristic> ;
                                                                            owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/BravaisLattice>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/pmd/co/characteristic> ;
                                                                            owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/CrystalStructure>
                                                                          ] ;
                                                          rdfs:label "Phase"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "A phase describes the crystal structure and the specific chemical compound. A specific compound can exist in different crystal structures as defined by polymorphism. In multi-phase materials, multiple distinct phases can form in distinct regions." ;
                                                          <https://w3id.org/pmd/co/definitionSource> "GPT-4 generated description with manual adjustments" .


###  https://w3id.org/pmd/materials-mechanics-ontology/PhysicalQuantity
