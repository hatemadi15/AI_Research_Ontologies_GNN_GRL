                                                                                                owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/Martensite>
                                                                                              ] ,
                                                                                              [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty <https://w3id.org/pmd/co/composedOf> ;
                                                                                                owl:someValuesFrom <https://w3id.org/pmd/materials-mechanics-ontology/RetainedAustenite>
                                                                                              ] ;
                                                                              rdfs:label "Martensite-Austenite island"@en ;
                                                                              <http://www.w3.org/2004/02/skos/core#definition> "Martensite-austenite islands are entities, typically smaller clusters with different morphology, composed of martensite and retained austenite."@en .


