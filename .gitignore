# Data and output files
*.csv
*.pt
*.png
!docs/figures/*.png
*.pkl
data/processed/

# Text files used as output/logs (excluding essential code or documentation txt files if any are meant to be kept)
# Note: If you have some .txt files you DO want to track (like requirements.txt), you can force add them later using `git add -f requirements.txt`
*.txt
!requirements.txt
!requirements-dev.txt
# the published split of MaterioMiner (data/raw/dataset/published_split/README.md)
!data/raw/dataset/published_split/*/*.txt

# Python cache / virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
.env

# Test / tool caches
.pytest_cache/
.ruff_cache/
